# Copy to .env.trader and fill in. NEVER commit .env.trader (it is git-ignored).
# Setup guide: services/trader/README.md

# HYPERLIQUID (default) or PACIFICA.
TRADER_VENUE=HYPERLIQUID

# TESTNET (default) or MAINNET. MAINNET trades real money and ALSO requires
# TRADER_ALLOW_MAINNET=true, so a single edit cannot reach real funds.
TRADER_NETWORK=TESTNET
TRADER_ALLOW_MAINNET=false

# The main wallet's PUBLIC address (safe to share).
# Hyperliquid: the 0x address Phantom trades perps from.
TRADER_ACCOUNT=

# The API wallet key approved on the exchange (Hyperliquid: app.hyperliquid.xyz/API).
# NEVER put your Phantom wallet's own private key or seed phrase here.
TRADER_API_PRIVATE_KEY=

# Percent of equity lost if a stop loss is hit. Hard maximum 5.
TRADER_DEFAULT_RISK_PERCENT=1

# Upper bound on leverage. The exchange's own per-market limit also applies.
TRADER_MAX_LEVERAGE=3

# Maximum slippage accepted on market entries and exits, in percent.
TRADER_SLIPPAGE_PERCENT=0.5

# Assumed taker fee per side (0.00045 = 0.045%, Hyperliquid's base tier).
TRADER_TAKER_FEE_RATE=0.00045
