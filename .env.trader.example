# Copy to .env.trader and fill in. NEVER commit .env.trader.
# Setup guide: services/trader/README.md

# TESTNET (default) or MAINNET. MAINNET trades real money and ALSO requires
# PACIFICA_ALLOW_MAINNET=true, so a single edit cannot reach real funds.
PACIFICA_NETWORK=TESTNET
PACIFICA_ALLOW_MAINNET=false

# Your Phantom wallet's PUBLIC address (safe to share).
PACIFICA_ACCOUNT=

# The API agent key created on Pacifica while connected with Phantom.
# NEVER put your Phantom wallet's own private key or seed phrase here.
PACIFICA_AGENT_PRIVATE_KEY=

# Percent of equity lost if a stop loss is hit. Hard maximum 5.
PACIFICA_DEFAULT_RISK_PERCENT=1

# Upper bound on leverage. The venue's own per-market limit also applies.
PACIFICA_MAX_LEVERAGE=3

# Maximum slippage accepted on market orders, in percent.
PACIFICA_SLIPPAGE_PERCENT=0.5

# Assumed taker fee per side (0.0005 = 0.05%). Set it to your actual fee tier.
PACIFICA_TAKER_FEE_RATE=0.0005
