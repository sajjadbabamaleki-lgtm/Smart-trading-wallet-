# Copy to .env and adjust. NEVER commit .env.
#
# Build 0.1 permits only DEVELOPMENT and TESTNET. Any other value fails startup.
# The venue URL is derived from this value — it is deliberately NOT configurable,
# so that changing a URL cannot enable real-money trading (Build 0.1 Rev.1 §46).
STW_EXECUTION_ENVIRONMENT=DEVELOPMENT

# Where public market data is read from. Independent of execution (ADR-009):
# reading a public order book risks nothing, so this may reach MAINNET_PUBLIC
# while execution stays hard-blocked above. Defaults to TESTNET, so reaching
# mainnet data is always an explicit choice.
#   DEVELOPMENT | TESTNET | MAINNET_PUBLIC
STW_MARKET_DATA_ENVIRONMENT=TESTNET

# Kill Switch 0.1 — no new exposure while false (Build 0.1 Rev.1 §57).
STW_TRADING_ENABLED=false

# Tradable asset allowlist. Build 0.1 Rev.2 is BTC only.
# Accepts a comma-separated list or a JSON array; values are upper-cased.
STW_ASSET_ALLOWLIST=BTC

# Maximum notional of a single test order, quote currency.
STW_MAX_ORDER_NOTIONAL=100

# A decision is refused when its inputs are older than this (seconds).
STW_DATA_STALENESS_LIMIT_SECONDS=5.0

# Execution intents expire; an expired intent can never be executed.
STW_INTENT_TTL_SECONDS=10.0

# Testnet API wallet. Never reuse a production credential.
#
# To place test orders, all three of these must be true at once, and each is a
# separate deliberate act:
#   STW_EXECUTION_ENVIRONMENT=TESTNET   (the venue URL follows from this)
#   STW_TRADING_ENABLED=true            (the kill switch, released)
#   a key below                         (something to sign with)
#
# Get them from https://app.hyperliquid-testnet.xyz : connect a wallet you use
# for nothing else, claim testnet USDC from the faucet, then create an API
# wallet under More -> API. The API wallet signs; the account it was created
# under is the one that holds the funds, so set ADDRESS to that account when
# they differ.
#
# The private key belongs in .env, which is git-ignored, and nowhere else.
STW_TESTNET_API_WALLET_ADDRESS=
STW_TESTNET_API_WALLET_PRIVATE_KEY=

# Storage (M1). These match the local Docker Compose stack. Store credentials
# live here rather than as defaults in the client modules, so that no secret
# sits in library code.
STW_POSTGRES_DSN=postgresql://stw:stw@localhost:5432/stw

STW_CLICKHOUSE_URL=http://localhost:8123
STW_CLICKHOUSE_USER=stw
STW_CLICKHOUSE_PASSWORD=stw
STW_CLICKHOUSE_DATABASE=stw

STW_REDIS_URL=redis://localhost:6379/0

STW_OBJECT_STORE_ENDPOINT=http://localhost:9000
STW_OBJECT_STORE_BUCKET=stw-raw
STW_OBJECT_STORE_ACCESS_KEY=stw
STW_OBJECT_STORE_SECRET_KEY=stw-dev-only

STW_LOG_LEVEL=INFO
